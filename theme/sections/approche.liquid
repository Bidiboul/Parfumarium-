<section class="section center">
  <div class="container reveal" style="max-width:820px">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="serif" style="font-size:clamp(1.7rem,3.6vw,2.3rem);font-weight:500;line-height:1.3;margin-top:18px">{{ section.settings.title }}</h2>
    <p style="color:var(--warmgray);max-width:600px;margin:18px auto 0">{{ section.settings.subtitle }}</p>
    <a class="btn btn-outline" style="margin-top:32px" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Notre approche",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre approche" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "Nous collaborons avec des partenaires spécialisés dans la création et la sélection de fragrances de qualité." },
    { "type": "textarea", "id": "subtitle", "label": "Sous-texte", "default": "Nos fragrances sont issues d'un savoir-faire dédié à la parfumerie contemporaine." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Explorer la collection" },
    { "type": "url", "id": "cta_url", "label": "Lien" }
  ],
  "presets": [{ "name": "Notre approche" }]
}
{% endschema %}
