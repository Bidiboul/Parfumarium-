<div class="page-hero" style="padding-bottom:36px">
  <div class="container">
    <span class="eyebrow">{{ 'general.search' | t }}</span>
    <h1>{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" class="newsletter-form" style="max-width:520px;margin:26px auto 0">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}"
             style="flex:1;border:1px solid rgba(22,19,17,0.15);border-radius:999px;padding:14px 24px;font:inherit;font-size:14px;background:#fff">
      <button type="submit" class="btn btn-primary">{{ 'general.search' | t }}</button>
    </form>
  </div>
</div>

<div class="container section" style="padding-top:36px">
  {%- if search.performed -%}
    <p class="count">{{ search.results_count }} {{ 'search.results' | t }} « {{ search.terms }} »</p>
    <div class="product-grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
