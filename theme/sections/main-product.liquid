<div class="container">
  <nav class="breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> /
    <a href="{{ routes.all_products_collection_url }}">{{ 'general.collection' | t }}</a> /
    <span style="color:var(--ink)">{{ product.title }}</span>
  </nav>

  <div class="product">
    <div class="product__media">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.title }}
      {%- endif -%}
      {%- if product.tags contains 'best-seller' -%}
        <span class="pcard__badge pcard__badge--dark" style="top:20px;left:20px">{{ 'product.best_seller' | t }}</span>
      {%- endif -%}
    </div>

    <div>
      <span class="eyebrow">{{ product.type }}</span>
      <h1 class="product__title">{{ product.title }}</h1>
      <p style="margin-top:10px">
        <span class="serif" data-price style="font-size:26px;color:var(--amber)">{{ product.selected_or_first_available_variant.price | money }}</span>
        <span style="font-size:13px;color:var(--warmgray)"> · {{ 'product.edp' | t }}</span>
      </p>

      <hr class="gold-rule" style="margin:24px 0">

      <div class="product__desc rte" style="padding:0;max-width:none">{{ product.description }}</div>

      {% form 'product', product, data-product-form: '' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="product__panel">
          <span class="eyebrow">{{ product.options_with_values[0].name | default: 'Contenance' }}</span>
          <div class="variants">
            {%- for variant in product.variants -%}
              <input type="radio" id="v-{{ variant.id }}" name="option-0" value="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}checked{% endif %}
                {% unless variant.available %}disabled{% endunless %}>
              <label for="v-{{ variant.id }}" class="{% unless variant.available %}soldout{% endunless %}">
                <span>{{ variant.title }}</span>
                {%- if variant.available -%}
                  <span class="vprice">{{ variant.price | money }}</span>
                {%- else -%}
                  <span class="vnote">{{ 'product.sold_out' | t }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </div>

        <div class="buybar">
          <div class="qty">
            <button type="button" onclick="var i=this.nextElementSibling;i.value=Math.max(1,+i.value-1)">−</button>
            <input type="number" name="quantity" value="1" min="1">
            <button type="button" onclick="var i=this.previousElementSibling;i.value=+i.value+1">+</button>
          </div>
          <button type="submit" class="btn btn-primary" data-add
                  data-label="{{ 'product.add' | t }}" data-soldout="{{ 'product.sold_out' | t }}"
                  style="flex:1;min-width:240px">
            {{ 'product.add' | t }}
          </button>
        </div>
      {% endform %}

      <div class="assurance">
        <span>{{ 'product.reassure_1' | t }}</span>
        <span>{{ 'product.reassure_2' | t }}</span>
        <span>{{ 'product.reassure_3' | t }}</span>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="product-json">
  {
    "currency": {{ cart.currency.iso_code | json }},
    "variants": [
      {%- for v in product.variants -%}
        { "id": {{ v.id }}, "price": {{ v.price }}, "available": {{ v.available }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<section class="section section--sand">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{{ 'product.related_eyebrow' | t }}</span>
      <h2>{{ 'product.related_title' | t }}</h2>
      <hr class="gold-rule">
    </div>
    <div class="product-grid">
      {%- assign shown = 0 -%}
      {%- for p in collections.all.products limit: 24 -%}
        {%- if p.id != product.id and shown < 4 -%}
          {% render 'product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Produit", "settings": [] }
{% endschema %}
