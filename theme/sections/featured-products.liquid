<section class="section" id="best-sellers">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.title }}</h2>
      <hr class="gold-rule">
      <p>{{ section.settings.subtitle }}</p>
    </div>
    <div class="product-grid">
      {%- assign col = section.settings.collection -%}
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for product in collections.all.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <div class="center mt-40">
      <a class="btn btn-outline" href="{{ routes.all_products_collection_url }}">{{ 'collection.view_all' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produits en avant",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les plus convoités" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos best-sellers" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Les fragrances raffinées qui ont conquis nos client·e·s — des parfums longue tenue, pensés pour marquer les esprits." },
    { "type": "collection", "id": "collection", "label": "Collection à afficher" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Produits en avant" }]
}
{% endschema %}
