<section class="hero">
  <div class="hero__img">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', alt: '' }}
    {%- else -%}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="">
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>
  <div class="container">
    <div class="hero__content">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="hero__title">{{ section.settings.title }}</h1>
      <p class="hero__sub">{{ section.settings.subtitle }}</p>
      <div class="hero__ctas">
        <a class="btn btn-ivory" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }} →</a>
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn-ghost-light" href="{{ section.settings.cta2_url | default: '#best-sellers' }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Maison de parfums · Vaison-la-Romaine" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "Des fragrances élégantes et intemporelles pour affirmer votre signature olfactive." },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Découvrez une sélection de parfums raffinés, pensés pour durer et marquer les esprits." },
    { "type": "text", "id": "cta_label", "label": "Bouton principal", "default": "Découvrir la collection" },
    { "type": "url", "id": "cta_url", "label": "Lien bouton principal" },
    { "type": "text", "id": "cta2_label", "label": "Bouton secondaire", "default": "Voir les best-sellers" },
    { "type": "url", "id": "cta2_url", "label": "Lien bouton secondaire" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
