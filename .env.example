# =====================================================================
# Configuration Shopify (mode "headless") — OPTIONNEL
# ---------------------------------------------------------------------
# Copiez ce fichier en ".env.local" et renseignez vos valeurs pour
# activer le vrai paiement Shopify. Sans ces variables, le site
# fonctionne en mode démonstration (aucune transaction réelle).
#
# Voir le guide pas-à-pas : SHOPIFY.md
# =====================================================================

# Domaine de votre boutique (PAS le domaine public, le ".myshopify.com")
SHOPIFY_STORE_DOMAIN=votre-boutique.myshopify.com

# Jeton d'accès Storefront API (Headless / app personnalisée)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=votre_token_storefront

# (Optionnel) Version de l'API Storefront
SHOPIFY_API_VERSION=2024-10
